# Copiar como .env para probar en local. En Vercel se cargan en
# Project Settings > Environment Variables.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente: tiene que ser de un dominio verificado en Resend
MAIL_FROM="Web Tecvol <web@tecvol.com.ar>"

# A quién llegan las consultas y los CV (se pueden poner varios separados por coma)
MAIL_TO=info@tecvol.com.ar
