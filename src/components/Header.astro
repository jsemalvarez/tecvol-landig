---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import SocialIcons from './SocialIcons.astro';

interface Props {
  current: 'inicio' | 'rrhh';
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label={`${site.name} - Inicio`}>
      <img src="/images/logo-tecvol.png" alt="Tecvol - Ingeniería electromecánica" width="200" height="47" />
    </a>

    <nav class="nav-main" aria-label="Principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class:list={['nav-link', { active: item.id === current }]} data-section={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-dropdown" aria-label="Abrir menú">
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>

    <SocialIcons class="header-social" />
  </div>

  <nav id="nav-dropdown" class="nav-dropdown" aria-label="Menú" hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { active: item.id === current }]} data-section={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #fff;
    box-shadow: 0 11px 47px -5px rgba(0, 0, 0, 0.36);
    padding: 20px 100px;
  }
  .header-inner {
    max-width: 1400px;
    margin-inline: auto;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: block;
    flex: 0 0 auto;
    padding-bottom: 6px;
  }
  .logo img {
    display: block;
    width: 200px;
    height: auto;
  }

  /* Menú horizontal */
  .nav-main ul {
    display: flex;
  }
  .nav-link {
    font-family: var(--font);
    font-size: 16px;
    font-weight: 500;
    line-height: 20px;
    text-transform: uppercase;
  }
  .nav-main .nav-link {
    position: relative;
    display: block;
    padding: 13px 28px;
    color: var(--gray);
    transition: color 0.3s;
  }
  .nav-main .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    background-color: var(--orange);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 2;
  }
  .nav-main .nav-link:hover,
  .nav-main .nav-link:focus-visible,
  .nav-main .nav-link.active {
    color: var(--orange);
  }
  .nav-main .nav-link:hover::after,
  .nav-main .nav-link:focus-visible::after,
  .nav-main .nav-link.active::after {
    opacity: 1;
  }

  /* Botón hamburguesa (tablet y celular) */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.25em;
    margin: 0 auto;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--orange);
    cursor: pointer;
    font-size: 22px;
  }
  .menu-toggle :global(svg) {
    width: 1em;
    height: 1em;
    fill: var(--orange);
  }
  .menu-toggle :global(.icon-close),
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* Menú desplegable */
  .nav-dropdown {
    position: absolute;
    left: 0;
    right: 0;
    top: 84px;
    background-color: #fff;
    z-index: 101;
  }
  .nav-dropdown[hidden] {
    display: none;
  }
  .nav-dropdown li:not(:last-child) {
    border-bottom: 1px solid var(--text);
  }
  .nav-dropdown .nav-link {
    display: block;
    padding: 10px 20px;
    color: #33373d;
    text-align: center;
  }
  .nav-dropdown .nav-link:hover,
  .nav-dropdown .nav-link.active {
    background-color: var(--orange);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .nav-main {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      padding: 0;
    }
    .header-inner {
      padding: 0;
      flex-wrap: wrap;
      justify-content: space-evenly;
    }
    .logo {
      margin: 20px 0 10px;
    }
    .menu-toggle {
      font-size: 28px;
      margin: 0;
    }
    .header-inner :global(.header-social) {
      flex-basis: 100%;
      justify-content: center;
      padding: 0 80px;
      margin-bottom: 10px;
    }
    .nav-dropdown {
      top: 76px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const dropdown = document.querySelector<HTMLElement>('#nav-dropdown');

  const setOpen = (open: boolean) => {
    if (!toggle || !dropdown) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    dropdown.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  dropdown?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // En la página de inicio, marca en el menú la sección que se está viendo.
  const sections = ['nosotros', 'servicios', 'obras', 'contacto']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          document
            .querySelectorAll(`.nav-link[data-section="${entry.target.id}"]`)
            .forEach((link) => link.classList.toggle('active', entry.isIntersecting));
        });
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
