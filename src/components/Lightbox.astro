---
// Visor de fotos a pantalla completa para la galería de obras.
// Abre cualquier enlace con [data-lightbox] dentro del grupo indicado.
import Icon from './Icon.astro';
---

<div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Galería de obras">
  <div class="lb-counter" data-lb-counter></div>
  <button class="lb-btn lb-close" type="button" data-lb-close aria-label="Cerrar"><Icon name="close" /></button>
  <button class="lb-btn lb-nav lb-prev" type="button" data-lb-prev aria-label="Anterior"><Icon name="chevron-left" /></button>
  <button class="lb-btn lb-nav lb-next" type="button" data-lb-next aria-label="Siguiente"><Icon name="chevron-right" /></button>
  <figure class="lb-figure">
    <img class="lb-image" data-lb-image alt="" />
    <figcaption class="lb-title" data-lb-title></figcaption>
  </figure>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
    color: rgba(238, 238, 238, 0.9);
    user-select: none;
    animation: lb-in 0.3s ease;
  }
  .lb[hidden] {
    display: none;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lb-image {
    display: block;
    max-width: 85vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.3), 0 0 8px -5px rgba(0, 0, 0, 0.3);
  }
  .lb-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    text-align: center;
    font-family: var(--font-system);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }
  .lb-counter {
    position: absolute;
    top: 20px;
    left: 20px;
    font-family: var(--font-system);
    font-size: 16px;
    letter-spacing: 1px;
    line-height: 20px;
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .lb-btn :global(svg) {
    fill: rgba(238, 238, 238, 0.9);
    transition: fill 0.2s;
  }
  .lb-btn:hover :global(svg) {
    fill: #fff;
  }
  .lb-close {
    top: 8px;
    right: 8px;
  }
  .lb-close :global(svg) {
    width: 20px;
    height: 20px;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 15%;
    max-width: 216px;
    height: 50%;
  }
  .lb-nav :global(svg) {
    width: 25px;
    height: 25px;
  }
  .lb-prev {
    left: 0;
  }
  .lb-next {
    right: 0;
  }
  @media (max-width: 767px) {
    .lb-image {
      max-width: 100vw;
    }
    .lb-nav {
      width: 20%;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-lb]');
  if (box) {
    const img = box.querySelector<HTMLImageElement>('[data-lb-image]')!;
    const title = box.querySelector<HTMLElement>('[data-lb-title]')!;
    const counter = box.querySelector<HTMLElement>('[data-lb-counter]')!;
    let items: HTMLAnchorElement[] = [];
    let index = 0;
    let lastFocus: Element | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      img.src = a.href;
      img.alt = a.dataset.title || '';
      title.textContent = a.dataset.title || '';
      counter.textContent = `${index + 1} / ${items.length}`;
    };
    const open = (group: string, i: number) => {
      items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${group}"]`)];
      lastFocus = document.activeElement;
      box.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      show(i);
      box.querySelector<HTMLElement>('[data-lb-close]')?.focus();
    };
    const close = () => {
      box.hidden = true;
      document.documentElement.style.overflow = '';
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    };

    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const group = a.dataset.lightbox!;
        const all = [...document.querySelectorAll(`a[data-lightbox="${group}"]`)];
        open(group, all.indexOf(a));
      });
    });

    box.querySelector('[data-lb-close]')?.addEventListener('click', close);
    box.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    box.addEventListener('click', (e) => {
      if (e.target === box || (e.target as HTMLElement).classList.contains('lb-figure')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Deslizar con el dedo en celulares
    let startX = 0;
    box.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
